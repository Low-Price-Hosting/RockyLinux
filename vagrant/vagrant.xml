      <!-- <vagrantconfig provider="virtualbox" virtualbox_guest_additions_present="true" virtualsize="5"/> -->
      <vagrantconfig provider="virtualbox" virtualbox_guest_additions_present="false" virtualsize="5" embedded_vagrantfile="VboxVagrantFile">
        <info name="Author"      >The Rocky Cloud SIG</info>
        <info name="Website"     >https://rockylinux.org</info>
        <info name="Artifacts"   >https://portal.cloud.hashicorp.com/vagrant/discover/rockylinux</info>
        <info name="Repository"  >https://git.resf.org/sig_core/rocky-kiwi-descriptions</info>
        <info name="Description" >Official First-party Vagrant Boxes built with KIWI</info>
      </vagrantconfig>
